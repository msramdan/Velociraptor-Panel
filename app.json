{
  "expo": {
    "name": "Velociraptor Panel",
    "slug": "velociraptor-panel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "velociraptor",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.msramdan.velociraptor"
    },
    "android": {
      "package": "com.msramdan.velociraptor",
      "adaptiveIcon": {
        "backgroundColor": "#070806",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070806",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ]
    ]
  }
}
